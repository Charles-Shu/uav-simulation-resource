<?xml version="1.0"?>
<sdf version="1.5">
  <model name="river1">
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <!-- 碰撞体：保持完整mesh -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://river1/meshes/model.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 河流部分：指定水面材质 -->
      <visual name="river_visual">
        <geometry>
          <mesh>
            <uri>model://river1/meshes/model.dae</uri>
            <submesh>
              <name>mesh_0</name> <!-- 第一个子网格通常是河流 -->
            </submesh>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://river1/materials/scripts</uri>
            <uri>model://river1/materials/textures</uri>
            <name>material_0</name> <!-- 河流水面材质 -->
          </script>
        </material>
      </visual>

      <!-- 草地部分：指定草地材质 -->
      <visual name="grass_visual">
        <geometry>
          <mesh>
            <uri>model://river1/meshes/model.dae</uri>
            <submesh>
              <name>mesh_1</name> <!-- 第二个子网格通常是草地 -->
            </submesh>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://river1/materials/scripts</uri>
            <uri>model://river1/materials/textures</uri>
            <name>material_1</name> <!-- 草地材质 -->
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>

