// Sandland5 material definition
// Applies sand5.png texture to the Blender-exported STL terrain mesh.

material Sandland5/Sand
{
  technique
  {
    pass
    {
      ambient  0.92 0.85 0.68 1.0
      diffuse  0.45 0.38 0.32 1.0
      specular 0.05 0.04 0.02 1.0 5

      texture_unit
      {
        texture sand5.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}
