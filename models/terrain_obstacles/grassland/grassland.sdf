<?xml version="1.0"?>
<sdf version="1.5">
  <model name="grassland">
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://grassland/meshes/model.dae</uri>
            <!-- 关键：英寸转米的精确缩放比例 1英寸=0.0254米 -->
            <scale>10 10 10</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://grassland/meshes/model.dae</uri>
            <!-- 必须和碰撞体使用完全相同的缩放比例 -->
            <scale>10 10 10</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://grassland/materials/scripts</uri>
            <uri>model://grassland/materials/textures</uri>
            <name>GrassLand/Artificial</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>

