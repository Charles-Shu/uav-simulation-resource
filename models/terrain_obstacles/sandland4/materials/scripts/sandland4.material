// Sandland4 material definition
// Applies sand4.png texture to the Blender-exported STL terrain mesh.
// The UV coordinates come from the Blender export.

material Sandland4/Sand
{
  technique
  {
    pass
    {
      ambient  0.92 0.85 0.68 1.0
      diffuse  0.95 0.88 0.72 1.0
      specular 0.05 0.04 0.02 1.0 5

      texture_unit
      {
        texture sand4.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}
