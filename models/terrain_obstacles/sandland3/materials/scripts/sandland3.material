// Sandland3 material definition

material Sandland3/Sand
{
  technique
  {
    pass
    {
      ambient  0.92 0.85 0.68 1.0
      diffuse  0.95 0.88 0.72 1.0
      specular 0.05 0.04 0.02 1.0 5

      texture_unit
      {
        texture sand3.jpg
        scale 0.15 0.15
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}
