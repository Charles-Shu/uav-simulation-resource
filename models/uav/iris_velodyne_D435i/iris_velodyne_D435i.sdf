<?xml version="1.0" ?>

<sdf version="1.5">

  <model name='iris_velodyne_D435i'>

    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <uri>model://D435i</uri>
      <pose>0.12 0 -0.02 3.1415926 0 -1.570796</pose>
    </include>
    <joint name="realsense_camera_joint" type="fixed">
      <child>D435i::camera_link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>
    
    <!-- Velodyne VLP-16 激光雷达 -->
    <include>
      <uri>model://velodyne_vlp16</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>velodyne</name>
    </include>
    <joint name="velodyne_joint" type="fixed">
      <child>velodyne::base_link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>

