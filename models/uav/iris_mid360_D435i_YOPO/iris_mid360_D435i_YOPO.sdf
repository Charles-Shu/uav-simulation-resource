<?xml version="1.0" ?>
<sdf version="1.5">
  <model name='iris_mid360_D435i_YOPO'>
    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <!--
        D435i_YOPO keeps the 640x480 color stream used by FAST-LIVO2 and
        provides YOPO's native 160x96, 20 m depth stream.
        The original upright camera mounting pose is preserved.
      -->
      <uri>model://D435i_YOPO</uri>
      <pose>0.12 0 0 1.5708 0 1.5708</pose>
    </include>

    <joint name="realsense_camera_joint" type="fixed">
      <child>D435i::camera_link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <include>
      <uri>model://Mid360</uri>
      <!-- Original top-mounted, upright Mid360 pose. -->
      <pose>0 0 0.05 0 0 0</pose>
    </include>

    <joint name="livox_joint" type="fixed">
      <child>Mid360::livox_base</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
