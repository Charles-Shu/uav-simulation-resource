<?xml version="1.0"?>
<sdf version="1.6">
  <world name="target_benchmark">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Targets use separate 40 m-wide lanes. Observation stations lie at x=0. -->
    <include><name>target_apartment</name><uri>model://apartment</uri><pose>30 0 0 0 0 0</pose></include>
    <include><name>target_house_1</name><uri>model://house_1</uri><pose>30 40 0 0 0 0</pose></include>
    <include><name>target_house_2</name><uri>model://house_2</uri><pose>30 80 0 0 0 0</pose></include>
    <include><name>target_house_3</name><uri>model://house_3</uri><pose>30 120 0 0 0 0</pose></include>
    <include><name>target_office</name><uri>model://office_building</uri><pose>30 165 0 0 0 0</pose></include>

    <model name="target_transmission_tower">
      <static>true</static>
      <pose>30 210 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><mesh>
          <uri>file:///home/sf/catkin_ws/src/my_gazebo_worlds/models/electrical+transmission+tower/model.dae</uri>
        </mesh></geometry></collision>
        <visual name="visual"><geometry><mesh>
          <uri>file:///home/sf/catkin_ws/src/my_gazebo_worlds/models/electrical+transmission+tower/model.dae</uri>
        </mesh></geometry></visual>
      </link>
    </model>

    <!-- Reposition this model to the selected target's registered camera pose. -->
    <model name="benchmark_reference_camera">
      <static>true</static>
      <pose>0 0 4 0 -0.15 0</pose>
      <link name="camera_link">
        <sensor name="comparison_camera" type="camera">
          <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>0 -35 35 0 0.55 0.8</pose></camera>
    </gui>
  </world>
</sdf>
