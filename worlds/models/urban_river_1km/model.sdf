<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6"><model name="urban_river_1km"><static>true</static><link name="terrain">
<visual name="rock"><geometry><mesh><uri>model://urban_river_1km/meshes/rock_visual.dae</uri></mesh></geometry></visual>
