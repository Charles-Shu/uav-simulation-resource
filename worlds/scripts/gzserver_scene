#!/usr/bin/env bash
# Keep ROS plugin paths and world arguments intact, including spaces.
set -euo pipefail
plugins=()
for library in libgazebo_ros_paths_plugin.so libgazebo_ros_api_plugin.so; do
  path="$(catkin_find --first-only "$library")"
  if [[ ! -f "$path" ]]; then
    printf 'Missing gazebo_ros plugin: %s\n' "$library" >&2
    exit 1
  fi
  plugins+=(-s "$path")
done
exec gzserver "${plugins[@]}" "$@"
