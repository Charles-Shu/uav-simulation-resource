Panels:
  - Class: rviz/Displays
    Help Topic: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Help Topic: rviz/Views
    Name: Views
  - Class: rviz/Time
    Help Topic: rviz/Time
    Name: Time
Preferences:
  Source_Frame: map
  Target_Frame: map
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Value: Lines
      Line Width: 0.03
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /obstacle_markers
      Name: Obstacle Markers
      Queue Size: 100
      Value: true
    # 自动加载主无人机雷达点云，在 RViz 中直接构建出 3D 物理环境点云图！
    # 注意：Livox 雷达在 /livox/lidar 上发布的是自定义 CustomMsg 格式。
    # 标准的 PointCloud2 格式点云通常发布在 /livox/points 或 /livox_points 话题上。
    - Class: rviz/PointCloud2
      Enabled: true
      Topic: /livox/points
      Name: Livox Lidar PointCloud
      Queue Size: 10
      Style: Points
      Size (Pixels): 2
      Alpha: 0.8
      Color Transformer: Intensity
      Value: true
    # 自动加载主无人机位置姿态（Odometry）
    - Class: rviz/Odometry
      Enabled: true
      Topic: /mavros/local_position/odom
      Name: Ego Drone Odom
      Queue Size: 10
      Shape: Arrow
      Color: 0; 255; 0
      Scale: 1.0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: Visualization Manager
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 4
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.78
    Saved: ~
