<?xml version="1.0"?>
<model>
  <name>iris_obstacle</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Agent</name>
    <email>agent@arena.ai</email>
  </author>

  <description>
    A simplified, lightweight iris drone model for use as a dynamic obstacle.
    It has no plugins or active joints, making it extremely lightweight, but
    it retains the exact visual appearance of the iris drone and has an efficient collision cylinder.
  </description>
</model>
