<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="bird_obstacle">
    <static>false</static>
    <link name="link">
      <kinematic>true</kinematic>
      
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <!-- 1. 鸟类身体 (拉长的白球体/椭球体) -->
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <!-- 制作一个流线型的身体，长 0.4m，宽/高 0.15m -->
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <!-- 缩放为长条状躯干 -->
        <pose>0 0 0 0 0 0</pose>
        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>0.9 0.9 0.9 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>

      <!-- 2. 鸟嘴 (橙色圆锥体，指向前方) -->
      <visual name="beak_visual">
        <pose>0.22 0 0.02 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <height>0.12</height>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.5 0.0 1.0</ambient>
          <diffuse>1.0 0.5 0.0 1.0</diffuse>
        </material>
      </visual>

      <!-- 3. 左内翼 (白色，向两侧延伸) -->
      <visual name="left_wing_inner_visual">
        <pose>0 0.22 0.02 0.2 0 0.1</pose>
        <geometry>
          <box>
            <size>0.12 0.35 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>0.9 0.9 0.9 1.0</diffuse>
        </material>
      </visual>

      <!-- 4. 左外翼 (白色，向下弯折，形成海鸥展翅的 M 形状) -->
      <visual name="left_wing_outer_visual">
        <pose>0.02 0.52 0.06 -0.1 0 0.2</pose>
        <geometry>
          <box>
            <size>0.08 0.3 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient> <!-- 翅尖带黑色 -->
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- 5. 右内翼 -->
      <visual name="right_wing_inner_visual">
        <pose>0 -0.22 0.02 -0.2 0 -0.1</pose>
        <geometry>
          <box>
            <size>0.12 0.35 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>0.9 0.9 0.9 1.0</diffuse>
        </material>
      </visual>

      <!-- 6. 右外翼 -->
      <visual name="right_wing_outer_visual">
        <pose>0.02 -0.52 0.06 0.1 0 -0.2</pose>
        <geometry>
          <box>
            <size>0.08 0.3 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- 7. 鸟尾 (灰色扁平片) -->
      <visual name="tail_visual">
        <pose>-0.24 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.14 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1.0</ambient>
          <diffuse>0.6 0.6 0.6 1.0</diffuse>
        </material>
      </visual>

      <!-- 碰撞体（Cylinder，保护半径 0.4m，完美用于雷达和深度相机检测避障） -->
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.4</radius>
          </sphere>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <contact>
            <ode/>
          </contact>
          <bounce/>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
