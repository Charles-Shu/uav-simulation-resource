<?xml version="1.0"?>
<model>
  <name>bird_obstacle</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Agent</name>
    <email>agent@arena.ai</email>
  </author>

  <description>
    A lightweight bird obstacle model.
    By default, it uses simple geometric primitives (sphere for body, boxes for wings) as a placeholder.
    To use a custom bird mesh (e.g., bird.dae with flap animations), you can replace the visual tag with a mesh tag.
  </description>
</model>
